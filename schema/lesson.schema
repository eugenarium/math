# schema/lesson.schema — DSL урока и карточки. JSON Schema 2020-12 в YAML-записи (проверка: ajv).
# Корень = урок (content/lessons/<раздел>/<id>.yml). Карточки: #/$defs/cards (content/cards/<раздел>.yml).
#
# УРОК = шесть фаз в фиксированном порядке:
#   int  интуиция          1–3 экрана
#   def  определение       1–4 экрана, минимум один {g: термин} — текст определения берётся из глоссария
#   ex   разобранный пример 1–2 экрана {x: pN} — строится из sol задачи pN, руками не пишется
#   pr   практика          4–8 параметрических задач (schema/problem.schema)
#   err  типичные ошибки   1–3 id из content/ref/errors.yml — тексты берутся из базы
#   sum  итог              2–4 строки «умею …»
# Заголовок, цель, предпосылки и время в уроке НЕ пишутся: они в карточке.
#
# ЭКРАН — одно из:
#   'текст'                              абзац, ≤320 знаков, $формулы$ KaTeX
#   {w: имя, …параметры, cap, ask, ans}  виджет из docs/WIDGETS.md
#   {g: термин}                          карточка определения из глоссария
#   {x: pN, seed: 3}                     разбор задачи pN по её sol
#   {ask: 'вопрос', ans: 'ответ'}        вопрос-предсказание, ответ открывается по касанию
#
# YAML: любой текст — в 'одинарных кавычках' (апостроф внутри удваивается: f''(x)).
# Двойные кавычки запрещены: в них ломается \frac, \to, \beta (E105).

$schema: https://json-schema.org/draft/2020-12/schema
$id: lesson.schema
$ref: '#/$defs/lesson'

$defs:
  lid: {type: string, pattern: '^[a-z]+[0-9]?\.[a-z0-9]+$'}        # c1.der
  gid: {type: string, pattern: '^[a-z][a-z0-9-]*$'}                # derivative
  eid: {type: string, pattern: '^[a-z]+[0-9]?\.[a-z0-9.-]+$'}      # c1.der.value
  pid: {type: string, pattern: '^p[1-9]$'}                         # p1…p9
  text: {type: string, minLength: 3, maxLength: 320}
  line: {type: string, minLength: 3, maxLength: 140}

  widget:
    type: object
    required: [w]
    properties:
      w: {type: string}                 # имя из реестра; параметры проверяет линтер (E401–E404)
      cap: {$ref: '#/$defs/line'}       # подпись-задание под виджетом
      ask: {$ref: '#/$defs/line'}
      ans: {$ref: '#/$defs/text'}
      h: {enum: [s, m, l]}              # высота: 35 / 50 / 65 % экрана; по умолчанию m
    dependentRequired: {ask: [ans]}

  screen:
    oneOf:
      - {$ref: '#/$defs/text'}
      - {$ref: '#/$defs/widget'}
      - type: object
        required: [g]
        additionalProperties: false
        properties: {g: {$ref: '#/$defs/gid'}}
      - type: object
        required: [x]
        additionalProperties: false
        properties:
          x: {$ref: '#/$defs/pid'}
          seed: {type: integer, minimum: 0}     # фиксирует числа примера; по умолчанию 1
      - type: object
        required: [ask, ans]
        additionalProperties: false
        properties:
          ask: {$ref: '#/$defs/line'}
          ans: {$ref: '#/$defs/text'}

  lesson:
    type: object
    additionalProperties: false
    required: [id, int, def, ex, pr, err, sum]
    properties:
      id: {$ref: '#/$defs/lid'}
      int:
        type: array
        minItems: 1
        maxItems: 3
        items: {$ref: '#/$defs/screen'}
      def:
        type: array
        minItems: 1
        maxItems: 4
        items: {$ref: '#/$defs/screen'}
        contains: {type: object, required: [g]}
      ex:
        type: array
        minItems: 1
        maxItems: 2
        items: {$ref: '#/$defs/screen'}
        contains: {type: object, required: [x]}
      pr:
        type: object
        minProperties: 4
        maxProperties: 8
        propertyNames: {$ref: '#/$defs/pid'}
        additionalProperties: {$ref: 'problem.schema'}
      err:
        type: array
        minItems: 1
        maxItems: 3
        uniqueItems: true
        items: {$ref: '#/$defs/eid'}
      sum:
        type: array
        minItems: 2
        maxItems: 4
        items: {$ref: '#/$defs/line'}

  # КАРТОЧКА — единственное, что исполнитель получает об уроке.
  card:
    type: object
    additionalProperties: false
    required: [t, goal, pre, g, k, e]
    properties:
      t: {type: string, minLength: 3, maxLength: 70}        # заголовок
      goal: {$ref: '#/$defs/line'}                          # «После урока умею …» — проверяемое действие
      pre:                                                  # полный список предпосылок (↑ из карты раскрыт)
        type: array
        uniqueItems: true
        items: {$ref: '#/$defs/lid'}
      g:                                                    # ключевые понятия: id глоссария, вводимые уроком
        type: array
        minItems: 1
        maxItems: 5
        items: {$ref: '#/$defs/gid'}
      w: {type: array, items: {type: string}}               # разрешённые виджеты; другие — E403
      k:                                                    # обязательные типы задач
        type: array
        minItems: 2
        uniqueItems: true
        items: {enum: [num, mc, expr, graph, spot, proof, sim]}
      e:                                                    # заблуждения для фазы err и диагностики
        type: array
        minItems: 1
        maxItems: 3
        items: {$ref: '#/$defs/eid'}
      p: {enum: [core, ext, opt]}                           # по умолчанию core
      min: {type: integer, minimum: 10, maximum: 30}        # по умолчанию 20
      n: {type: integer, minimum: 4, maximum: 8}            # число задач; по умолчанию 5
      note: {$ref: '#/$defs/text'}                          # подсказка исполнителю: акцент, границы темы

  cards:
    type: object
    propertyNames: {$ref: '#/$defs/lid'}
    additionalProperties: {$ref: '#/$defs/card'}
